{
  "name": "@cafe/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.check.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check-integrity": "tsx scripts/check-data-integrity.ts",
    "db:test-integrity": "tsx scripts/test-integrity-migration.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "tables:qr": "tsx scripts/print-table-qr.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
"dependencies": {
    "@prisma/client": "6.19.3",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.3.0",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.5.0",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "24.10.13",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "7.2.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
