# Copy to server/.env for local development.
# Never use the local database credentials or example secrets in production.
NODE_ENV=development
# Render supplies PORT in production; this is the local fallback.
PORT=4000

# Local Docker Compose PostgreSQL connection. For Neon/Render production, set the
# full provider connection URI in the hosting dashboard; do not commit it here.
DATABASE_URL="postgresql://cafe:cafe_dev_password@localhost:5432/cafe_qr?schema=public"

# Placeholder only; generate a unique random secret before starting the server.
# Production startup rejects this example value.
JWT_SECRET="change-me-generate-a-random-secret-at-least-48-characters"
SESSION_TTL_HOURS=12

# Local Vite origin. In production, set to the exact Netlify site origin.
CLIENT_ORIGIN="http://localhost:5173"

# False for local HTTP; true in production behind HTTPS.
COOKIE_SECURE=false

# Optional in local development; production must enable table QR key checks.
REQUIRE_TABLE_KEY=false

# Required explicitly in production. Render currently uses one trusted proxy.
TRUST_PROXY_HOPS=1

RATE_LIMIT_PER_IP=60
CURRENCY=USD
# Rates are decimals: 0.08 means 8%.
TAX_RATE=0
SERVICE_CHARGE_RATE=0

# Optional. Defaults to uploads/ in the project root.
# UPLOAD_DIR=uploads

# Local seed admin (only used by npm run db:seed; never set in production).
SEED_ADMIN_EMAIL=admin@cafe.local
SEED_ADMIN_PASSWORD="replace-with-a-unique-local-admin-password"

# Optional overrides for npm run admin:create. Prefer its hidden terminal prompt.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional port for npm run dev:db; defaults to 5432.
# PGPORT=5432
