# ---------------------------------------------------------------------------
# Copy this file to server/.env and adjust for your environment.
# ---------------------------------------------------------------------------

# REQUIRED in production: set to development/test locally, production only on deployed servers.
NODE_ENV=development
PORT=4000

# REQUIRED in production: use a real PostgreSQL connection string that does not point at the local dev user or embedded DB.
# Exact check: reject any URL containing `cafe_dev_password`; also reject the `cafe` user on localhost when paired with that default password.
DATABASE_URL="postgresql://cafe:cafe_dev_password@localhost:5432/cafe_qr?schema=public"

# REQUIRED in production: at least 48 characters, different from the example placeholder, and must not contain "change-me".
JWT_SECRET="change-me-to-a-random-string-at-least-48-characters-long"
SESSION_TTL_HOURS=12

# REQUIRED in production: must start with https:// and match the deployed frontend origin.
CLIENT_ORIGIN="http://localhost:5173"

# REQUIRED in production: must be true behind HTTPS.
COOKIE_SECURE=false

# REQUIRED in production: must be true to enforce table QR tokens.
# NOTE: NODE_ENV=development disables the origin guard and keeps this relaxed for local testing.
REQUIRE_TABLE_KEY=false

# REQUIRED explicitly in production (integer; defaults to 1 only outside production).
# Must equal the number of reverse proxies in front of the app. A wrong value makes rate limits see the proxy IP or lets clients spoof their IP.
TRUST_PROXY_HOPS=1

# Per-minute IP cap for public order/service routes.
RATE_LIMIT_PER_IP=60

# Money configuration. Rates are decimals: 0.08 = 8%.
CURRENCY=USD
TAX_RATE=0
SERVICE_CHARGE_RATE=0

# Optional directory for menu item images (defaults to uploads/ in the project root).
# UPLOAD_DIR=uploads

# Seed credentials (used only by `npm run db:seed`). These must be left unset in production.
SEED_ADMIN_EMAIL=admin@cafe.local
SEED_ADMIN_PASSWORD=Admin123!
